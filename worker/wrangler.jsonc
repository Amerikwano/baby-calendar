{
  "name": "baby-calendar-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ALLOWED_ORIGIN": "https://amerikwano.github.io", "DAILY_LIMIT": "10", "MONTHLY_LIMIT": "60" },
  "durable_objects": { "bindings": [{ "name": "AI", "class_name": "BabyAI" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BabyAI"] }]
}
